[2026-06-26T07:49:50.085Z] EXECUTE createPythonFile {"path":"C:\\Users\\MSI\\Desktop\\myraa_flappy_bird.py","overwrite":true,"content":"import pygame\nimport random\n\n# Initialize Pygame\npygame.init()\n\n# Basic Setup\nWIDTH, HEIGHT = 400, 600\nWIN = pygame.display.set_mode((WIDTH, HEIGHT))\npygame.display.set_caption(\"Myraa's Flappy Bird\")\nCLOCK = pygame.time.Clock()\n\n# Colors\nWHITE = (255, 255, 255)\nBLACK = (0, 0, 0)\nSKY_BLUE = (135, 206, 235)\n\n# Game Variables\ndef reset_game():\n    global bird_y, bird_velocity, pipe_x, pipe_height, score\n    bird_y = HEIGHT // 2\n    bird_velocity = 0\n    pipe_x = WIDTH\n    pipe_height = random.randint(150, 400)\n    score = 0\n\nreset_game()\ngravity = 0.5\njump = -8\ngap = 150\ngame_over = False\n\ndef draw_window():\n    WIN.fill(SKY_BLUE)\n    pygame.draw.rect(WIN, BLACK, (50, int(bird_y), 30, 30))  # Bird\n    pygame.draw.rect(WIN, BLACK, (pipe_x, 0, 50, pipe_height))  # Top Pipe\n    pygame.draw.rect(WIN, BLACK, (pipe_x, pipe_height + gap, 50, HEIGHT - (pipe_height + gap)))  # Bottom Pipe\n    \n    # Simple score display\n    font = pygame.font.SysFont(None, 36)\n    score_text = font.render(f\"Score: {score}\", True, BLACK)\n    WIN.blit(score_text, (10, 10))\n    \n    if game_over:\n        game_over_text = font.render(\"Game Over! Press Space\", True, BLACK)\n        text_rect = game_over_text.get_rect(center=(WIDTH/2, HEIGHT/2))\n        WIN.blit(game_over_text, text_rect)\n        \n    pygame.display.update()\n\n# Main Game Loop\nrun = True\nwhile run:\n    CLOCK.tick(30)\n    \n    for event in pygame.event.get():\n        if event.type == pygame.QUIT:\n            run = False\n        if event.type == pygame.KEYDOWN:\n            if event.key == pygame.K_SPACE:\n                if game_over:\n                    reset_game()\n                    game_over = False\n                else:\n                    bird_velocity = jump\n\n    if not game_over:\n        bird_velocity += gravity\n        bird_y += bird_velocity\n        pipe_x -= 5\n\n        # Pipe Respawn and Scrolling\n        if pipe_x < -50:\n            pipe_x = WIDTH\n            pipe_height = random.randint(150, 400)\n            score += 1\n\n        # Collision with ground or ceiling\n        if bird_y > HEIGHT or bird_y < 0:\n            game_over = True\n\n        # Pipe collision\n        bird_rect = pygame.Rect(50, int(bird_y), 30, 30)\n        top_pipe_rect = pygame.Rect(pipe_x, 0, 50, pipe_height)\n        bottom_pipe_rect = pygame.Rect(pipe_x, pipe_height + gap, 50, HEIGHT - (pipe_height + gap))\n        \n        if bird_rect.colliderect(top_pipe_rect) or bird_rect.colliderect(bottom_pipe_rect):\n            game_over = True\n\n    draw_window()\n\npygame.quit()\n"}
